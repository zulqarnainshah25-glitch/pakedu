# --- Server-Side Gemini AI Configuration (Node.js & Vercel Functions) ---
# In Google AI Studio / Cloud Run / Vercel, GEMINI_API_KEY is injected at runtime.
GEMINI_API_KEY=""

# Active free-tier Gemini models
GEMINI_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# --- Express Server & Stability Configuration ---
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_RATE_LIMIT_PER_MINUTE="45"
API_CACHE_TTL_MINUTES="30"

# --- Client-Side Public Portal & Cross-Platform SSO Settings ---
VITE_APP_NAME="PakEdu & Sindh SELD Official Portal"
VITE_ATLIER_CV_URL="https://atlier-cv.vercel.app/"

# --- Firebase Web Client Configuration (Vite) ---
