rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // Global Safety Net (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Core Identity, Validation & Role-Based Access Control (RBAC) Helpers
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Super Admin: Prefer custom claim request.auth.token.superAdmin == true (NOT an email check)
    // with user doc role 'super-admin' or isSuperAdmin == true as fallback
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('superAdmin', false) == true ||
        (hasUserDoc() && (
          userDoc().get('isSuperAdmin', false) == true ||
          (userDoc().get('role', '') == 'super-admin' && userDoc().get('status', 'active') == 'active')
        ))
      );
    }

    // School Staff Member: Active teacher, admin, or principal belonging to schoolId (strictly excludes Super Admin and parents)
    function isSchoolMember(schoolId) {
      return hasUserDoc() &&
        userDoc().get('status', '') == 'active' &&
        userDoc().get('schoolId', '') == schoolId &&
        (userDoc().get('role', '') in ['teacher', 'admin', 'principal']);
    }

    // Verified Parent Member: Active parent linked strictly to a single child in schoolId
    function isSchoolParent(schoolId) {
      return hasUserDoc() &&
        userDoc().get('status', '') == 'active' &&
        userDoc().get('schoolId', '') == schoolId &&
        userDoc().get('role', '') == 'parent';
    }

    // Verified Student Member: Active student linked strictly to their own studentId in schoolId
    function isSchoolStudent(schoolId) {
      return hasUserDoc() &&
        userDoc().get('status', '') == 'active' &&
        userDoc().get('schoolId', '') == schoolId &&
        userDoc().get('role', '') == 'student';
    }

    function isSchoolStudentInClass(schoolId, targetClassId) {
      return isSchoolStudent(schoolId) &&
        userDoc().get('studentId', '') != '' &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(userDoc().get('studentId', ''))) &&
        targetClassId == get(/databases/$(database)/documents/schools/$(schoolId)/students/$(userDoc().get('studentId', ''))).data.get('classId', '');
    }

    function isSchoolParentInClass(schoolId, targetClassId) {
      return isSchoolParent(schoolId) &&
        userDoc().get('childStudentId', '') != '' &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(userDoc().get('childStudentId', ''))) &&
        targetClassId == get(/databases/$(database)/documents/schools/$(schoolId)/students/$(userDoc().get('childStudentId', ''))).data.get('classId', '');
    }

    function parentLinkDoc(linkId) {
      return get(/databases/$(database)/documents/parentLinks/$(linkId)).data;
    }

    function studentLinkDoc(linkId) {
      return get(/databases/$(database)/documents/studentLinks/$(linkId)).data;
    }

    // Server-side verification of Parent Portal claim against Admin/Incharge /parentLinks record
    function isVerifiedParentClaim(data) {
      return isSignedIn() &&
        data.get('parentLinkId', '') is string &&
        isValidId(data.get('parentLinkId', '')) &&
        exists(/databases/$(database)/documents/parentLinks/$(data.get('parentLinkId', ''))) &&
        parentLinkDoc(data.get('parentLinkId', '')).schoolId == data.get('schoolId', '') &&
        parentLinkDoc(data.get('parentLinkId', '')).studentId == data.get('childStudentId', '') &&
        parentLinkDoc(data.get('parentLinkId', '')).grNumber == data.get('childGrNumber', '') &&
        (
          (
            parentLinkDoc(data.get('parentLinkId', '')).get('parentEmail', '') != '' &&
            request.auth.token.email != null &&
            parentLinkDoc(data.get('parentLinkId', '')).get('parentEmail', '').lower() == request.auth.token.email.lower()
          ) || (
            parentLinkDoc(data.get('parentLinkId', '')).get('inviteCode', '') != '' &&
            data.get('linkedInviteCode', '') == parentLinkDoc(data.get('parentLinkId', '')).get('inviteCode', '')
          ) || (
            parentLinkDoc(data.get('parentLinkId', '')).get('guardianPhone', '') != '' &&
            data.get('phone', '') == parentLinkDoc(data.get('parentLinkId', '')).get('guardianPhone', '')
          )
        );
    }

    // Server-side verification of Student Portal claim against Admin/Incharge /studentLinks record
    function isVerifiedStudentClaim(data) {
      return isSignedIn() &&
        data.get('studentLinkId', '') is string &&
        isValidId(data.get('studentLinkId', '')) &&
        exists(/databases/$(database)/documents/studentLinks/$(data.get('studentLinkId', ''))) &&
        studentLinkDoc(data.get('studentLinkId', '')).schoolId == data.get('schoolId', '') &&
        studentLinkDoc(data.get('studentLinkId', '')).studentId == data.get('studentId', '') &&
        studentLinkDoc(data.get('studentLinkId', '')).grNumber == data.get('studentGrNumber', '') &&
        (
          (
            studentLinkDoc(data.get('studentLinkId', '')).get('studentEmail', '') != '' &&
            request.auth.token.email != null &&
            studentLinkDoc(data.get('studentLinkId', '')).get('studentEmail', '').lower() == request.auth.token.email.lower()
          ) || (
            studentLinkDoc(data.get('studentLinkId', '')).get('inviteCode', '') != '' &&
            data.get('linkedInviteCode', '') == studentLinkDoc(data.get('studentLinkId', '')).get('inviteCode', '')
          )
        );
    }

    // School Admin: Strictly school-level Admin or Principal (excludes Super Admin from direct tenant mutations)
    function isSchoolAdmin(schoolId) {
      return isSchoolMember(schoolId) &&
        (userDoc().get('role', '') == 'admin' || userDoc().get('role', '') == 'principal');
    }

    // Verified Faculty Author: Teacher or Admin with status 'active'
    function canAuthorSyllabus() {
      return isSuperAdmin() || (
        hasUserDoc() &&
        userDoc().get('status', '') == 'active' &&
        (userDoc().get('role', '') in ['teacher', 'admin', 'principal'])
      );
    }

    // =========================================================================
    // Validation Schemas for School Management System (SMS) Documents
    // =========================================================================
    function isValidClassSection(data) {
      return data.keys().hasAll(['id', 'grade', 'section', 'medium', 'academicYear']) &&
        data.keys().hasOnly(['id', 'grade', 'section', 'medium', 'academicYear', 'classTeacherId', 'classTeacherName', 'roomNumber', 'totalStudents', 'capacity', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 50 &&
        data.section is string && data.section.size() >= 1 && data.section.size() <= 50 &&
        data.medium is string && (data.medium == 'English' || data.medium == 'Urdu' || data.medium == 'Sindhi') &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 30;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'grNumber', 'fullName', 'fatherName', 'gender', 'classId', 'guardianPhone', 'status']) &&
        data.keys().hasOnly([
          'id', 'grNumber', 'fullName', 'name', 'fatherName', 'gender', 'dob', 'admissionDate',
          'classId', 'currentClassId', 'grade', 'currentGrade', 'section', 'currentSection',
          'bFormNumber', 'bFormOrCnic', 'guardianPhone', 'address', 'status',
          'concessionId', 'concessionTitle', 'concessionType', 'concessionValue', 'advanceBalance',
          'photoUrl', 'parentEmail', 'parentUid', 'parentInviteCode', 'parentLinkedAt',
          'studentEmail', 'studentUid', 'studentInviteCode', 'studentLinkedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.grNumber is string && data.grNumber.size() >= 1 && data.grNumber.size() <= 50 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.fatherName is string && data.fatherName.size() >= 1 && data.fatherName.size() <= 120 &&
        data.guardianPhone is string && data.guardianPhone.size() >= 5 && data.guardianPhone.size() <= 30 &&
        data.gender is string && (data.gender == 'Male' || data.gender == 'Female' || data.gender == 'Other') &&
        data.classId is string && isValidId(data.classId) &&
        data.status is string && (data.status in ['active', 'struck_off', 'transferred', 'graduated', 'Active', 'Struck Off', 'SLC Issued', 'Passed Out']);
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'schoolId', 'classId', 'date', 'records']) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'classId', 'grade', 'section', 'date', 'records',
          'conductedBy', 'conductedByUid', 'markedByUid', 'markedByName', 'markedAt',
          'summary', 'notes', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.classId is string && isValidId(data.classId) &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.records is map;
    }

    function isValidFeeStructure(data) {
      return data.keys().hasAll(['id', 'schoolId', 'classId', 'grade', 'monthlyTuitionFee']) &&
        data.keys().hasOnly(['id', 'schoolId', 'classId', 'grade', 'monthlyTuitionFee', 'admissionFee', 'examFee', 'customCharges', 'academicYear', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.classId is string && isValidId(data.classId) &&
        data.monthlyTuitionFee is number;
    }

    function isValidFeePayment(data) {
      return data.keys().hasAll(['id', 'schoolId', 'studentId', 'month', 'netAmount', 'paidAmount', 'status']) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'studentId', 'studentName', 'grNumber', 'classId', 'grade', 'section',
          'month', 'monthLabel', 'academicYear', 'baseAmount', 'customChargesAmount',
          'discount', 'concessionId', 'concessionTitle', 'concessionPercent',
          'netAmount', 'paidAmount', 'pendingBalance', 'advanceUsed', 'advanceGenerated',
          'allocatedNextMonth', 'installments',
          'status', 'paymentDate', 'paymentMethod', 'receiptNumber', 'notes',
          'recordedByUid', 'recordedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.studentId is string && isValidId(data.studentId) &&
        data.month is string &&
        data.netAmount is number &&
        data.paidAmount is number &&
        (data.status == 'paid' || data.status == 'unpaid' || data.status == 'partial');
    }

    function isValidFeeConcession(data) {
      return data.keys().hasAll(['id', 'schoolId', 'title', 'discountType', 'value']) &&
        data.keys().hasOnly(['id', 'schoolId', 'title', 'discountType', 'value', 'description', 'isActive', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        (data.discountType == 'percentage' || data.discountType == 'fixed') &&
        data.value is number && data.value >= 0;
    }

    function isValidExam(data) {
      return data.keys().hasAll(['id', 'schoolId', 'title', 'classIds', 'subjects', 'status']) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'title', 'termType', 'academicYear', 'startDate', 'endDate',
          'classIds', 'subjects', 'status', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.classIds is list &&
        data.subjects is list && data.subjects.size() >= 1 &&
        (data.status in ['draft', 'published', 'archived']);
    }

    function isValidExamMarks(data) {
      return data.keys().hasAll(['id', 'schoolId', 'examId', 'classId', 'studentId', 'subjectMarks']) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'examId', 'classId', 'studentId', 'studentName', 'grNumber',
          'grade', 'section', 'subjectMarks', 'absentSubjects', 'remarks',
          'totalObtained', 'totalMax', 'percentage', 'overallGrade', 'resultStatus',
          'enteredByUid', 'enteredByName', 'enteredAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.examId is string && isValidId(data.examId) &&
        data.classId is string && isValidId(data.classId) &&
        data.studentId is string && isValidId(data.studentId) &&
        data.subjectMarks is map;
    }

    function isValidSalaryStructure(data) {
      return data.keys().hasAll(['id', 'schoolId', 'employeeId', 'employeeName', 'basicSalary', 'allowances', 'deductions', 'netSalary']) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'employeeId', 'employeeUid', 'employeeName', 'employeeEmail',
          'designation', 'employeeType', 'bpsGrade', 'cnic', 'phone',
          'bankName', 'bankAccountTitle', 'accountNumber',
          'basicSalary', 'allowances', 'deductions',
          'totalAllowances', 'grossSalary', 'totalDeductions', 'netSalary',
          'notes', 'createdByUid', 'createdByName', 'updatedByUid', 'updatedByName',
          'lastAction', 'auditTrail', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.employeeId is string && isValidId(data.employeeId) &&
        data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120 &&
        data.basicSalary is number && data.basicSalary >= 0 &&
        data.allowances is list &&
        data.deductions is list &&
        data.netSalary is number && data.netSalary >= 0;
    }

    function isValidPayslip(data) {
      return data.keys().hasAll(['id', 'payslipNumber', 'schoolId', 'month', 'employeeId', 'employeeName', 'basicSalary', 'netSalary', 'status', 'isFinalized']) &&
        data.keys().hasOnly([
          'id', 'payslipNumber', 'schoolId', 'month', 'monthLabel', 'year', 'monthNumber',
          'employeeId', 'employeeUid', 'employeeName', 'employeeEmail',
          'designation', 'employeeType', 'bpsGrade', 'cnic', 'phone',
          'bankName', 'bankAccountTitle', 'accountNumber',
          'basicSalary', 'allowances', 'deductions',
          'totalAllowances', 'grossSalary', 'totalDeductions',
          'adjustmentAmount', 'adjustmentReason', 'netSalary',
          'status', 'isFinalized', 'finalizedAt', 'paymentDate', 'paymentMethod', 'transactionRef',
          'notes', 'generatedByUid', 'generatedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.month is string && data.month.size() >= 6 && data.month.size() <= 16 &&
        data.employeeId is string && isValidId(data.employeeId) &&
        data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120 &&
        data.basicSalary is number && data.basicSalary >= 0 &&
        data.netSalary is number && data.netSalary >= 0 &&
        data.isFinalized is bool &&
        (data.status in ['draft', 'finalized', 'paid']);
    }

    function isTeacherPayslipPortalEnabled(schoolId) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/payrollSettings/config) ||
        get(/databases/$(database)/documents/schools/$(schoolId)/payrollSettings/config).data.get('teacherPayslipAccessEnabled', true) == true;
    }

    function isValidSchoolLessonPlan(data) {
      return data.keys().hasAll([
        'id', 'schoolId', 'classId', 'grade', 'teacherId', 'subject', 'chapter', 'topic', 'slos', 'sharedWithParents'
      ]) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'classId', 'grade', 'section', 'teacherId', 'teacherUid', 'teacherName',
          'board', 'curriculumSection', 'subject', 'chapter', 'topic', 'duration', 'planType', 'syllabusSource',
          'slos', 'previousKnowledge', 'teachingAids', 'introduction', 'procedure', 'teacherActivities',
          'studentActivities', 'assessment', 'homework', 'vocabulary', 'lifeSkills', 'teacherReflection',
          'questions', 'exercise', 'worksheetPrompt', 'bloomAssessment',
          'sharedWithParents', 'sharedAt', 'reviewedByAdmin', 'adminReviewNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.classId is string && isValidId(data.classId) &&
        data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120 &&
        data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 240 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 240 &&
        data.sharedWithParents is bool;
    }

    function isValidSchoolQuestionPaper(data) {
      return data.keys().hasAll([
        'id', 'schoolId', 'classId', 'subject', 'difficulty', 'totalMarks', 'language', 'syllabusCovered', 'paper', 'attachedToExam'
      ]) &&
        data.keys().hasOnly([
          'id', 'schoolId', 'examId', 'examTitle', 'attachedToExam', 'attachedAt',
          'classId', 'className', 'grade', 'section', 'subject', 'difficulty', 'totalMarks',
          'timeAllowed', 'language', 'syllabusCovered', 'linkedLessonPlanIds', 'linkedLessonPlanTopics',
          'generationSource', 'paper', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.schoolId is string && isValidId(data.schoolId) &&
        data.classId is string && isValidId(data.classId) &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120 &&
        (data.difficulty in ['Easy', 'Medium', 'Hard']) &&
        (data.language in ['English', 'Urdu', 'Sindhi']) &&
        data.totalMarks is number && data.totalMarks >= 10 && data.totalMarks <= 200 &&
        data.attachedToExam is bool &&
        data.paper is map;
    }

    // =========================================================================
    // Validation Blueprint for SyllabusLessonPlan
    // =========================================================================
    function isValidSyllabusLessonPlan(data) {
      return data.keys().hasAll([
        'board', 'section', 'className', 'subject', 'chapter', 'topic', 'duration',
        'planType', 'slos', 'previousKnowledge', 'teachingAids', 'introduction',
        'procedure', 'teacherActivities', 'studentActivities', 'assessment',
        'homework', 'vocabulary', 'lifeSkills', 'teacherReflection', 'questions',
        'exercise', 'worksheetPrompt', 'bloomAssessment', 'visibility', 'authorId',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'board', 'section', 'className', 'subject', 'chapter', 'topic', 'duration',
        'planType', 'slos', 'previousKnowledge', 'teachingAids', 'introduction',
        'procedure', 'teacherActivities', 'studentActivities', 'assessment',
        'homework', 'vocabulary', 'lifeSkills', 'teacherReflection', 'questions',
        'exercise', 'worksheetPrompt', 'bloomAssessment', 'visibility', 'authorId',
        'createdAt', 'updatedAt'
      ]) &&
      data.board is string && data.board.size() >= 1 && data.board.size() <= 50 &&
      (data.board == 'Sindh STBB' || data.board == 'Punjab PTB') &&
      data.section is string && data.section.size() >= 1 && data.section.size() <= 50 &&
      (data.section == 'Primary' || data.section == 'Middle' || data.section == 'Secondary' || data.section == 'Higher Secondary') &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
      data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100 &&
      data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 200 &&
      data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200 &&
      data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 50 &&
      data.planType is string && data.planType.size() >= 1 && data.planType.size() <= 20 &&
      (data.planType == 'Daily' || data.planType == 'Weekly') &&
      data.slos is string && data.slos.size() >= 1 && data.slos.size() <= 3000 &&
      data.previousKnowledge is string && data.previousKnowledge.size() >= 1 && data.previousKnowledge.size() <= 2000 &&
      data.teachingAids is string && data.teachingAids.size() >= 1 && data.teachingAids.size() <= 2000 &&
      data.introduction is string && data.introduction.size() >= 1 && data.introduction.size() <= 3000 &&
      data.procedure is string && data.procedure.size() >= 1 && data.procedure.size() <= 5000 &&
      data.teacherActivities is string && data.teacherActivities.size() >= 1 && data.teacherActivities.size() <= 3000 &&
      data.studentActivities is string && data.studentActivities.size() >= 1 && data.studentActivities.size() <= 3000 &&
      data.assessment is string && data.assessment.size() >= 1 && data.assessment.size() <= 3000 &&
      data.homework is string && data.homework.size() >= 1 && data.homework.size() <= 2000 &&
      data.vocabulary is string && data.vocabulary.size() >= 1 && data.vocabulary.size() <= 4000 &&
      data.lifeSkills is string && data.lifeSkills.size() >= 1 && data.lifeSkills.size() <= 2000 &&
      data.teacherReflection is string && data.teacherReflection.size() >= 1 && data.teacherReflection.size() <= 2000 &&
      data.questions is string && data.questions.size() >= 1 && data.questions.size() <= 4000 &&
      data.exercise is string && data.exercise.size() >= 1 && data.exercise.size() <= 4000 &&
      data.worksheetPrompt is string && data.worksheetPrompt.size() >= 1 && data.worksheetPrompt.size() <= 4000 &&
      data.bloomAssessment is string && data.bloomAssessment.size() >= 1 && data.bloomAssessment.size() <= 4000 &&
      data.visibility is string && data.visibility == 'public' &&
      data.authorId is string && isValidId(data.authorId) &&
      data.authorId == request.auth.uid &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // =========================================================================
    // 1. Users Collection (/users/{uid})
    // =========================================================================
    match /users/{uid} {
      // User can read their own profile; Super Admin can read all; School Admin can read/list staff of their school
      allow get: if isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == uid) ||
        (resource != null && existing().get('schoolId', '') != '' && isSchoolAdmin(existing().get('schoolId', '')));
      allow list: if isSuperAdmin() ||
        (existing().get('schoolId', '') != '' && isSchoolAdmin(existing().get('schoolId', '')));

      // Newly authenticated user can create own profile during signup immediately:
      // - 'teacher' or 'admin' with status 'none' or 'pending' (no schoolId required yet!)
      // - 'parent' with status 'active' ONLY when server-verified against /parentLinks (or 'pending' before link)
      // - Never allow self-assigning 'super-admin', isSuperAdmin, isAdmissionIncharge, or active admin/teacher status.
      // Active School Admin may also create/activate a teacher doc for their own school during approval.
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.auth.uid == uid &&
        isValidId(uid) &&
        incoming().get('uid', uid) == uid &&
        (!('isSuperAdmin' in incoming()) || incoming().isSuperAdmin == false) &&
        incoming().get('isAdmissionIncharge', false) == false &&
        (
          (
            (incoming().get('role', '') in ['teacher', 'admin']) &&
            (incoming().get('status', '') in ['none', 'pending'])
          ) || (
            incoming().get('role', '') == 'parent' &&
            incoming().get('status', '') == 'active' &&
            isVerifiedParentClaim(incoming())
          ) || (
            incoming().get('role', '') == 'parent' &&
            incoming().get('status', '') == 'pending'
          ) || (
            incoming().get('role', '') == 'student' &&
            incoming().get('status', '') == 'active' &&
            isVerifiedStudentClaim(incoming())
          ) || (
            incoming().get('role', '') == 'student' &&
            incoming().get('status', '') == 'pending'
          )
        )
      ) || (
        isSignedIn() &&
        isValidId(uid) &&
        (!('isSuperAdmin' in incoming()) || incoming().isSuperAdmin == false) &&
        incoming().get('role', '') == 'teacher' &&
        (incoming().get('status', '') in ['pending', 'active']) &&
        incoming().get('schoolId', '') is string &&
        incoming().get('schoolId', '').size() > 0 &&
        isSchoolAdmin(incoming().get('schoolId', ''))
      );

      // Update rules:
      // 1. Super Admin can update any user (including approving school admins)
      // 2. User can update own doc:
      //    - normal edits keep role, schoolId, status unchanged
      //    - onboarding / school-linking transition while unlinked (schoolId == '') or status in ['none', 'rejected'] -> 'none' | 'pending'
      //    - verified parent claim linking from unlinked/pending state -> role 'parent', status 'active'
      //    - never self-elevate to 'active' admin/teacher or 'super-admin'
      // 3. Active School Admin can approve/update teachers belonging to (or applying to) their school
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        isValidId(uid) &&
        (!('isSuperAdmin' in incoming()) || incoming().isSuperAdmin == existing().get('isSuperAdmin', false)) &&
        (
          (
            request.auth.uid == uid &&
            incoming().get('isAdmissionIncharge', false) == existing().get('isAdmissionIncharge', false) &&
            (
              (
                incoming().get('role', '') == existing().get('role', '') &&
                incoming().get('schoolId', '') == existing().get('schoolId', '') &&
                incoming().get('status', '') == existing().get('status', '')
              ) || (
                (existing().get('schoolId', '') == '' || (existing().get('status', 'none') in ['none', 'rejected'])) &&
                (incoming().get('status', '') in ['none', 'pending']) &&
                (incoming().get('role', '') in ['teacher', 'admin', 'parent', 'student'])
              ) || (
                (existing().get('schoolId', '') == '' || (existing().get('status', 'none') in ['none', 'pending', 'rejected'])) &&
                incoming().get('role', '') == 'parent' &&
                incoming().get('status', '') == 'active' &&
                isVerifiedParentClaim(incoming())
              ) || (
                (existing().get('schoolId', '') == '' || (existing().get('status', 'none') in ['none', 'pending', 'rejected'])) &&
                incoming().get('role', '') == 'student' &&
                incoming().get('status', '') == 'active' &&
                isVerifiedStudentClaim(incoming())
              )
            )
          ) || (
            existing().get('isSuperAdmin', false) == false &&
            existing().get('role', '') != 'super-admin' &&
            incoming().get('role', '') == 'teacher' &&
            (incoming().get('status', '') in ['active', 'rejected', 'pending']) &&
            incoming().get('schoolId', '') is string &&
            incoming().get('schoolId', '').size() > 0 &&
            isSchoolAdmin(incoming().get('schoolId', '')) &&
            (
              existing().get('schoolId', '') == '' ||
              existing().get('schoolId', '') == incoming().get('schoolId', '')
            )
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Schools Collection (/schools/{schoolId})
    // =========================================================================
    match /schools/{schoolId} {
      // Directory read allowed for active schools (required for teacher signup school selector),
      // pending school creators, members of that school, and super-admin.
      allow get, list: if isSchoolMember(schoolId) ||
        isSchoolParent(schoolId) ||
        isSchoolStudent(schoolId) ||
        isSuperAdmin() ||
        (resource != null && (
          existing().get('status', '') == 'active' ||
          (isSignedIn() && (request.auth.uid in existing().get('adminUids', [])))
        ));

      // Super Admin can create any school; authenticated user registering a new school
      // can create a pending_approval school listing themselves in adminUids.
      allow create: if isValidId(schoolId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          incoming().get('status', '') == 'pending_approval' &&
          (request.auth.uid in incoming().get('adminUids', []))
        )
      );

      // Update by Super Admin only (or school admin for limited profile fields, or active staff syncing aggregated analytics)
      allow update: if isValidId(schoolId) && (
        isSuperAdmin() || (
          isSchoolAdmin(schoolId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'phone',
            'email',
            'address',
            'activeAcademicYear',
            'logoUrl',
            'analytics',
            'updatedAt'
          ])
        ) || (
          isSchoolMember(schoolId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'analytics',
            'updatedAt'
          ])
        )
      );

      // No delete allowed on school records
      allow delete: if false;

      // --- Subcollection: Classes (/schools/{schoolId}/classes/{classId}) ---
      match /classes/{classId} {
        allow get, list: if isSchoolMember(schoolId) || isSchoolParent(schoolId) || isSchoolStudentInClass(schoolId, classId);
        allow create, update: if isSchoolAdmin(schoolId) && isValidId(classId) && isValidClassSection(incoming());
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Students (/schools/{schoolId}/students/{studentId}) ---
      // Parents strictly READ-ONLY for their linked childStudentId; Students strictly READ-ONLY for their own studentId!
      match /students/{studentId} {
        allow get, list: if isSchoolMember(schoolId) || (
          isSchoolParent(schoolId) && (
            studentId == userDoc().get('childStudentId', '') ||
            existing().get('parentUid', '') == request.auth.uid
          )
        ) || (
          isSchoolStudent(schoolId) && (
            studentId == userDoc().get('studentId', '') ||
            existing().get('studentUid', '') == request.auth.uid
          )
        );
        allow create: if isValidId(studentId) && isValidStudent(incoming()) && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('isAdmissionIncharge', false) == true
          )
        );
        allow update: if isValidId(studentId) && isValidStudent(incoming()) && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('isAdmissionIncharge', false) == true
          ) || (
            // Verified parent may initialize a missing studentInviteCode for their own child only
            isSchoolParent(schoolId) &&
            studentId == userDoc().get('childStudentId', '') &&
            existing().get('studentInviteCode', '') == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['studentInviteCode', 'updatedAt']) &&
            incoming().get('studentInviteCode', '') is string &&
            incoming().get('studentInviteCode', '').size() >= 6
          )
        );
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Daily Attendance (/schools/{schoolId}/attendance/{attendanceId}) ---
      // Parents & Students strictly READ-ONLY (students scoped to their own class).
      match /attendance/{attendanceId} {
        allow get, list: if isSchoolMember(schoolId) || isSchoolParent(schoolId) ||
          isSchoolStudentInClass(schoolId, existing().get('classId', ''));
        allow create, update: if isValidId(attendanceId) && isValidAttendance(incoming()) && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('role', '') == 'teacher' &&
            ('assignedClassIds' in userDoc()) &&
            incoming().classId in userDoc().assignedClassIds
          )
        );
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Teachers (/schools/{schoolId}/teachers/{teacherId}) ---
      // Read-only allowed for Super Admin so Salary & Payroll module can list employees without touching student PII
      match /teachers/{teacherId} {
        allow get, list: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update, delete: if isSchoolAdmin(schoolId) && isValidId(teacherId);
      }

      // --- Subcollection: Join Requests (/schools/{schoolId}/joinRequests/{id}) ---
      match /joinRequests/{id} {
        // School Admin & Super Admin can read; user can read own request
        allow get, list: if isSchoolAdmin(schoolId) || (
          isSignedIn() && (
            resource.data.get('uid', '') == request.auth.uid ||
            resource.data.get('userId', '') == request.auth.uid
          )
        );

        // User can create a request only for themself (userId == request.auth.uid, status 'pending')
        allow create: if isSignedIn() &&
          isValidId(id) &&
          (incoming().get('uid', '') == request.auth.uid || incoming().get('userId', '') == request.auth.uid) &&
          incoming().get('status', '') == 'pending' &&
          incoming().get('schoolId', '') == schoolId;

        // School Admin and Super Admin can review/update/delete
        allow update, delete: if isSchoolAdmin(schoolId) && isValidId(id);
      }

      // --- Subcollection: Fee Structures (/schools/{schoolId}/feeStructures/{classId}) ---
      match /feeStructures/{classId} {
        allow get, list: if isSchoolMember(schoolId) || isSchoolParent(schoolId) || isSchoolStudentInClass(schoolId, classId);
        allow create, update: if isSchoolAdmin(schoolId) && isValidId(classId) && isValidFeeStructure(incoming());
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Fee Payments (/schools/{schoolId}/feePayments/{paymentId}) ---
      // Parents & Students strictly READ-ONLY for their own studentId payments only.
      match /feePayments/{paymentId} {
        allow get, list: if isSchoolMember(schoolId) || (
          isSchoolParent(schoolId) &&
          existing().get('studentId', '') == userDoc().get('childStudentId', '')
        ) || (
          isSchoolStudent(schoolId) &&
          existing().get('studentId', '') == userDoc().get('studentId', '')
        );
        allow create, update: if isValidId(paymentId) && isValidFeePayment(incoming()) && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('isAdmissionIncharge', false) == true
          )
        );
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Fee Concessions (/schools/{schoolId}/feeConcessions/{concessionId}) ---
      match /feeConcessions/{concessionId} {
        allow get, list: if isSchoolMember(schoolId) || isSchoolParent(schoolId) || isSchoolStudent(schoolId);
        allow create, update: if isSchoolAdmin(schoolId) && isValidId(concessionId) && isValidFeeConcession(incoming());
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Exams (/schools/{schoolId}/exams/{examId}) ---
      // Admin-only creation/edit; active staff can read all; parents & students can ONLY read published exams.
      match /exams/{examId} {
        allow get, list: if isSchoolMember(schoolId) || (
          (isSchoolParent(schoolId) || isSchoolStudent(schoolId)) && existing().get('status', '') == 'published'
        );
        allow create, update: if isSchoolAdmin(schoolId) &&
          isValidId(examId) &&
          isValidExam(incoming()) &&
          incoming().schoolId == schoolId;
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Exam Marks (/schools/{schoolId}/marks/{markId}) ---
      // Active staff can read all; parents & students strictly READ-ONLY for their own studentId only!
      // Writes strictly restricted to School Admins OR Teachers assigned to incoming().classId.
      match /marks/{markId} {
        allow get, list: if isSchoolMember(schoolId) || (
          isSchoolParent(schoolId) &&
          existing().get('studentId', '') == userDoc().get('childStudentId', '')
        ) || (
          isSchoolStudent(schoolId) &&
          existing().get('studentId', '') == userDoc().get('studentId', '')
        );
        allow create, update: if isValidId(markId) &&
          isValidExamMarks(incoming()) &&
          incoming().schoolId == schoolId && (
            isSchoolAdmin(schoolId) || (
              isSchoolMember(schoolId) &&
              userDoc().get('role', '') == 'teacher' &&
              ('assignedClassIds' in userDoc()) &&
              incoming().classId in userDoc().assignedClassIds
            )
          );
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Timetable (/schools/{schoolId}/timetable/{entryId}) ---
      // Admin-only writes; school staff & parents read-only; students read-only scoped to own class.
      match /timetable/{entryId} {
        allow get, list: if isSchoolMember(schoolId) || isSchoolParent(schoolId) ||
          isSchoolStudentInClass(schoolId, existing().get('classId', ''));
        allow create, update: if isSchoolAdmin(schoolId) &&
          isValidId(entryId) &&
          request.resource.data.keys().hasAll(['id', 'schoolId', 'classId', 'day', 'periodNumber', 'subject', 'teacherId']) &&
          request.resource.data.schoolId == schoolId &&
          (request.resource.data.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']) &&
          request.resource.data.periodNumber is number;
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Homework (/schools/{schoolId}/homework/{homeworkId}) ---
      // Admin or assigned class teacher can create/update; parents read-only; students read-only scoped to own class.
      match /homework/{homeworkId} {
        allow get, list: if isSchoolMember(schoolId) || isSchoolParent(schoolId) ||
          isSchoolStudentInClass(schoolId, existing().get('classId', ''));
        allow create, update: if isValidId(homeworkId) &&
          request.resource.data.keys().hasAll(['id', 'schoolId', 'classId', 'subject', 'description', 'dueDate', 'teacherId']) &&
          request.resource.data.schoolId == schoolId && (
            isSchoolAdmin(schoolId) || (
              isSchoolMember(schoolId) &&
              userDoc().get('role', '') == 'teacher' &&
              ('assignedClassIds' in userDoc()) &&
              request.resource.data.classId in userDoc().assignedClassIds
            )
          );
        allow delete: if isSchoolAdmin(schoolId) || (
          isSchoolMember(schoolId) &&
          existing().get('teacherId', '') == request.auth.uid
        );
      }

      // --- Subcollection: Official Certificates (/schools/{schoolId}/certificates/{certificateId}) ---
      // Admin-only create/update/delete; staff can read; parents & students read only for their own studentId.
      match /certificates/{certificateId} {
        allow get, list: if isSchoolMember(schoolId) || (
          isSchoolParent(schoolId) &&
          existing().get('studentId', '') == userDoc().get('childStudentId', '')
        ) || (
          isSchoolStudent(schoolId) &&
          existing().get('studentId', '') == userDoc().get('studentId', '')
        );
        allow create, update: if isSchoolAdmin(schoolId) &&
          isValidId(certificateId) &&
          request.resource.data.keys().hasAll(['id', 'certificateNumber', 'type', 'schoolId', 'studentId', 'studentName', 'grNumber', 'issueDate']) &&
          request.resource.data.schoolId == schoolId &&
          (request.resource.data.type in ['transfer', 'character']);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // --- Subcollection: Salary Structures (/schools/{schoolId}/salaryStructures/{employeeId}) ---
      // School Admin & Super Admin can read/write all; active School Members can read ONLY their own salary structure for self-service notifications.
      match /salaryStructures/{employeeId} {
        allow get, list: if isSchoolAdmin(schoolId) || isSuperAdmin() || (
          isSchoolMember(schoolId) && (
            employeeId == request.auth.uid ||
            existing().get('employeeUid', '') == request.auth.uid ||
            existing().get('employeeId', '') == request.auth.uid ||
            (('email' in request.auth.token) && request.auth.token.email != null && existing().get('employeeEmail', '') == request.auth.token.email.lower())
          )
        );
        allow create, update: if (isSchoolAdmin(schoolId) || isSuperAdmin()) &&
          isValidId(employeeId) &&
          isValidSalaryStructure(incoming()) &&
          incoming().schoolId == schoolId &&
          incoming().employeeId == employeeId;
        allow delete: if isSchoolAdmin(schoolId) || isSuperAdmin();
      }

      // --- Subcollection: Payroll Settings (/schools/{schoolId}/payrollSettings/{settingId}) ---
      match /payrollSettings/{settingId} {
        allow get, list: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update: if (isSchoolAdmin(schoolId) || isSuperAdmin()) &&
          isValidId(settingId) &&
          incoming().keys().hasAll(['id', 'schoolId', 'teacherPayslipAccessEnabled']) &&
          incoming().schoolId == schoolId &&
          incoming().teacherPayslipAccessEnabled is bool;
        allow delete: if isSchoolAdmin(schoolId) || isSuperAdmin();
      }

      // --- Subcollection: Monthly Payslips (/schools/{schoolId}/payslips/{payslipId}) ---
      // School Admin & Super Admin can read/write all; Teachers can read ONLY their own finalized/paid payslips (if enabled).
      match /payslips/{payslipId} {
        allow get, list: if isSchoolAdmin(schoolId) || isSuperAdmin() || (
          isSchoolMember(schoolId) &&
          isTeacherPayslipPortalEnabled(schoolId) &&
          existing().get('isFinalized', false) == true && (
            existing().get('employeeId', '') == request.auth.uid ||
            existing().get('employeeUid', '') == request.auth.uid ||
            (('email' in request.auth.token) && request.auth.token.email != null && existing().get('employeeEmail', '') == request.auth.token.email.lower())
          )
        );
        allow create, update: if (isSchoolAdmin(schoolId) || isSuperAdmin()) &&
          isValidId(payslipId) &&
          isValidPayslip(incoming()) &&
          incoming().schoolId == schoolId;
        allow delete: if isSchoolAdmin(schoolId) || isSuperAdmin();
      }

      // --- Subcollection: School AI Lesson Plans (/schools/{schoolId}/lessonPlans/{planId}) ---
      // Strictly isolated from Super Admin:
      // - Admin / Principal: full read/write/review/delete across schoolId
      // - Teachers: ONLY create/read/update/delete for their assignedClassIds
      // - Parents: Read-only ONLY when sharedWithParents == true AND matching child's classId
      match /lessonPlans/{planId} {
        allow get, list: if !isSuperAdmin() && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('role', '') == 'teacher' &&
            ('assignedClassIds' in userDoc()) &&
            existing().get('classId', '') in userDoc().assignedClassIds
          ) || (
            existing().get('sharedWithParents', false) == true &&
            isSchoolParentInClass(schoolId, existing().get('classId', ''))
          )
        );
        allow create: if !isSuperAdmin() &&
          isValidId(planId) &&
          isValidSchoolLessonPlan(incoming()) &&
          incoming().schoolId == schoolId && (
            isSchoolAdmin(schoolId) || (
              isSchoolMember(schoolId) &&
              userDoc().get('role', '') == 'teacher' &&
              ('assignedClassIds' in userDoc()) &&
              incoming().classId in userDoc().assignedClassIds
            )
          );
        allow update: if !isSuperAdmin() &&
          isValidId(planId) &&
          isValidSchoolLessonPlan(incoming()) &&
          incoming().schoolId == schoolId && (
            isSchoolAdmin(schoolId) || (
              isSchoolMember(schoolId) &&
              userDoc().get('role', '') == 'teacher' &&
              ('assignedClassIds' in userDoc()) &&
              existing().get('classId', '') in userDoc().assignedClassIds &&
              incoming().classId in userDoc().assignedClassIds
            )
          );
        allow delete: if !isSuperAdmin() && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('role', '') == 'teacher' &&
            ('assignedClassIds' in userDoc()) &&
            existing().get('classId', '') in userDoc().assignedClassIds
          )
        );
      }

      // --- Subcollection: School AI Question Papers (/schools/{schoolId}/questionPapers/{paperId}) ---
      // Strictly isolated from Super Admin, Parents, and Students:
      // - Admin / Principal: full read/write/attach/delete across schoolId
      // - Teachers: ONLY create/read/update/delete for their assignedClassIds
      match /questionPapers/{paperId} {
        allow get, list: if !isSuperAdmin() && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('role', '') == 'teacher' &&
            ('assignedClassIds' in userDoc()) &&
            existing().get('classId', '') in userDoc().assignedClassIds
          )
        );
        allow create: if !isSuperAdmin() &&
          isValidId(paperId) &&
          isValidSchoolQuestionPaper(incoming()) &&
          incoming().schoolId == schoolId && (
            isSchoolAdmin(schoolId) || (
              isSchoolMember(schoolId) &&
              userDoc().get('role', '') == 'teacher' &&
              ('assignedClassIds' in userDoc()) &&
              incoming().classId in userDoc().assignedClassIds
            )
          );
        allow update: if !isSuperAdmin() &&
          isValidId(paperId) &&
          isValidSchoolQuestionPaper(incoming()) &&
          incoming().schoolId == schoolId && (
            isSchoolAdmin(schoolId) || (
              isSchoolMember(schoolId) &&
              userDoc().get('role', '') == 'teacher' &&
              ('assignedClassIds' in userDoc()) &&
              existing().get('classId', '') in userDoc().assignedClassIds &&
              incoming().classId in userDoc().assignedClassIds
            )
          );
        allow delete: if !isSuperAdmin() && (
          isSchoolAdmin(schoolId) || (
            isSchoolMember(schoolId) &&
            userDoc().get('role', '') == 'teacher' &&
            ('assignedClassIds' in userDoc()) &&
            existing().get('classId', '') in userDoc().assignedClassIds
          )
        );
      }
    }

    // =========================================================================
    // 2B. Parent-Student Invite & Linkage Index (/parentLinks/{linkId})
    // =========================================================================
    match /parentLinks/{linkId} {
      // Exact doc lookup by schoolId__GR (signed-in users) so signing-up parents can verify email/phone/code
      allow get: if isSignedIn() && isValidId(linkId);
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          (existing().get('schoolId', '') != '' && isSchoolAdmin(existing().get('schoolId', ''))) ||
          (existing().get('schoolId', '') != '' && isSchoolMember(existing().get('schoolId', '')) && userDoc().get('isAdmissionIncharge', false) == true) ||
          (existing().get('parentEmail', '') != '' && request.auth.token.email != null && existing().get('parentEmail', '').lower() == request.auth.token.email.lower()) ||
          existing().get('claimedByUid', '') == request.auth.uid
        )
      );
      allow create: if isValidId(linkId) && (
        isSuperAdmin() || (
          incoming().get('schoolId', '') != '' && (
            isSchoolAdmin(incoming().get('schoolId', '')) || (
              isSchoolMember(incoming().get('schoolId', '')) &&
              userDoc().get('isAdmissionIncharge', false) == true
            )
          )
        )
      );
      allow delete: if isValidId(linkId) && (
        isSuperAdmin() || (
          existing().get('schoolId', '') != '' && (
            isSchoolAdmin(existing().get('schoolId', '')) || (
              isSchoolMember(existing().get('schoolId', '')) &&
              userDoc().get('isAdmissionIncharge', false) == true
            )
          )
        )
      );
      allow update: if isValidId(linkId) && (
        isSuperAdmin() || (
          existing().get('schoolId', '') != '' && (
            isSchoolAdmin(existing().get('schoolId', '')) || (
              isSchoolMember(existing().get('schoolId', '')) &&
              userDoc().get('isAdmissionIncharge', false) == true
            )
          )
        ) || (
          // Signed-in parent claiming their verified link
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['claimedByUid', 'claimedAt', 'status', 'updatedAt']) &&
          incoming().get('claimedByUid', '') == request.auth.uid &&
          incoming().get('status', '') == 'linked'
        )
      );
    }

    // =========================================================================
    // 2B-2. Student Self-Login Invite & Linkage Index (/studentLinks/{linkId})
    // =========================================================================
    match /studentLinks/{linkId} {
      // Exact doc lookup by schoolId__GR (signed-in users) so signing-up students can verify email/invite code
      allow get: if isSignedIn() && isValidId(linkId);
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          (existing().get('schoolId', '') != '' && isSchoolAdmin(existing().get('schoolId', ''))) ||
          (existing().get('schoolId', '') != '' && isSchoolMember(existing().get('schoolId', '')) && userDoc().get('isAdmissionIncharge', false) == true) ||
          (existing().get('studentEmail', '') != '' && request.auth.token.email != null && existing().get('studentEmail', '').lower() == request.auth.token.email.lower()) ||
          existing().get('claimedByUid', '') == request.auth.uid
        )
      );
      allow create: if isValidId(linkId) && (
        isSuperAdmin() || (
          incoming().get('schoolId', '') != '' && (
            isSchoolAdmin(incoming().get('schoolId', '')) || (
              isSchoolMember(incoming().get('schoolId', '')) &&
              userDoc().get('isAdmissionIncharge', false) == true
            ) || (
              // Verified parent may initialize a Student Portal invite for their own linked child
              isSchoolParent(incoming().get('schoolId', '')) &&
              incoming().get('studentId', '') == userDoc().get('childStudentId', '') &&
              incoming().get('status', '') == 'available'
            )
          )
        )
      );
      allow delete: if isValidId(linkId) && (
        isSuperAdmin() || (
          existing().get('schoolId', '') != '' && (
            isSchoolAdmin(existing().get('schoolId', '')) || (
              isSchoolMember(existing().get('schoolId', '')) &&
              userDoc().get('isAdmissionIncharge', false) == true
            )
          )
        )
      );
      allow update: if isValidId(linkId) && (
        isSuperAdmin() || (
          existing().get('schoolId', '') != '' && (
            isSchoolAdmin(existing().get('schoolId', '')) || (
              isSchoolMember(existing().get('schoolId', '')) &&
              userDoc().get('isAdmissionIncharge', false) == true
            )
          )
        ) || (
          // Signed-in student claiming their verified link
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['claimedByUid', 'claimedAt', 'status', 'updatedAt']) &&
          incoming().get('claimedByUid', '') == request.auth.uid &&
          incoming().get('status', '') == 'linked'
        )
      );
    }

    // =========================================================================
    // 2C. Global Notice Board / Announcements (/globalNotices/{noticeId})
    // Super Admin composes/deletes notices for All or Specific schools;
    // Active School Admins read their targeted notices & mark readBySchools.
    // =========================================================================
    match /globalNotices/{noticeId} {
      allow get, list: if isSuperAdmin() || (
        hasUserDoc() &&
        userDoc().get('status', '') == 'active' && (
          existing().get('targetType', 'all') == 'all' ||
          (userDoc().get('schoolId', '') != '' && userDoc().get('schoolId', '') in existing().get('targetSchoolIds', []))
        )
      );
      allow create: if isSuperAdmin() &&
        isValidId(noticeId) &&
        incoming().keys().hasAll(['id', 'title', 'message', 'priority', 'date', 'targetType']) &&
        (incoming().priority in ['high', 'medium', 'low']) &&
        (incoming().targetType in ['all', 'specific']);
      allow delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        hasUserDoc() &&
        userDoc().get('status', '') == 'active' &&
        (userDoc().get('role', '') in ['admin', 'principal']) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['readBySchools', 'updatedAt'])
      );
    }

    // =========================================================================
    // 3. School Registration Requests (/schoolRegistrationRequests/{id})
    // =========================================================================
    match /schoolRegistrationRequests/{id} {
      // Authenticated user can create their own request (status 'pending')
      allow create: if isSignedIn() &&
        isValidId(id) &&
        (
          incoming().get('adminUid', '') == request.auth.uid ||
          incoming().get('uid', '') == request.auth.uid ||
          incoming().get('userId', '') == request.auth.uid
        ) &&
        incoming().get('status', '') == 'pending';

      // Super Admin can read all; creator can read their own request
      allow get, list: if isSuperAdmin() || (
        isSignedIn() && (
          resource.data.get('adminUid', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid
        )
      );

      // Only Super Admin can review/update or delete school registration requests
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. Syllabus Data Collection (/syllabus_data/{lessonId})
    // =========================================================================
    match /syllabus_data/{lessonId} {
      // Single-document read & list: validate ID and enforce public visibility
      allow get: if isValidId(lessonId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      // Create: verified user + active teacher/admin role + schema validation + server timestamps
      allow create: if isVerifiedUser() &&
        canAuthorSyllabus() &&
        isValidId(lessonId) &&
        isValidSyllabusLessonPlan(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Update: verified user + active teacher/admin role + author ownership + immutability
      allow update: if isVerifiedUser() &&
        canAuthorSyllabus() &&
        isValidId(lessonId) &&
        isValidSyllabusLessonPlan(incoming()) &&
        existing().authorId == request.auth.uid &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'duration', 'planType', 'slos', 'previousKnowledge', 'teachingAids',
          'introduction', 'procedure', 'teacherActivities', 'studentActivities',
          'assessment', 'homework', 'vocabulary', 'lifeSkills', 'teacherReflection',
          'questions', 'exercise', 'worksheetPrompt', 'bloomAssessment', 'updatedAt'
        ]);

      // Delete: Super Admin or verified author with active status
      allow delete: if isSuperAdmin() || (
        isVerifiedUser() &&
        canAuthorSyllabus() &&
        isValidId(lessonId) &&
        existing().authorId == request.auth.uid
      );
    }

    // =========================================================================
    // 5. CV Studio & Supporting Collections (CVs, Templates, Settings, Payments)
    // =========================================================================
    match /cvs/{cvId} {
      allow read, write: if isSuperAdmin() || (
        isSignedIn() && isValidId(cvId) && (
          (resource == null && incoming().userId == request.auth.uid) ||
          (resource != null && existing().userId == request.auth.uid)
        )
      );
    }

    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /payment_requests/{id} {
      allow create: if isSignedIn() && isValidId(id);
      allow read: if isSuperAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    match /payment_proofs/{id} {
      allow create: if isSignedIn() && isValidId(id);
      allow read: if isSuperAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }
  }
}
